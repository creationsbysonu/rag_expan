# ---------------------------------------------------------------------------
# Backend / operations env — copy to .env
#   cp .env.example .env
# Never commit .env. Values here map to the Supabase project + Google AI key.
# ---------------------------------------------------------------------------

# Supabase project (Project Settings -> Data API / API Keys)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Postgres connection used by apply_migration.py and migrate_to_supabase.py
# (Project Settings -> Database -> Connection string -> Session pooler)
DB_URL=postgresql://postgres.YOUR-PROJECT:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DB_PASSWORD=YOUR-DB-PASSWORD

# Supabase Management API token (Account -> Access Tokens).
# Needed only by deploy_supabase.py to push secrets and deploy Edge Functions.
SUPABASE_ACCESS_TOKEN=sbp_your-token

# Google AI Studio key for embeddings + generation (single key for both)
GEMINI_API_KEY=your-gemini-api-key
# Optional overrides
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-2.5-flash

# Shared secret required by the ingest function for scripted uploads
INGEST_SECRET=generate-a-long-random-string

# Optional tuning
RATE_LIMIT_PER_MINUTE=30
EMBED_PAUSE=1.0

# Optional: Vercel deploy (scripts/deploy_vercel.sh)
VERCEL_TOKEN=
VERCEL_SITE_URL=https://your-app.vercel.app
