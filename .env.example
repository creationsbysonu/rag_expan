# ---------------------------------------------------------------------------
# Backend / operations env — copy to .env
#   cp .env.example .env
# Never commit .env. Values here map to the Supabase project + Google AI key.
# ---------------------------------------------------------------------------

# Supabase project (Project Settings -> Data API / API Keys)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Postgres connection used by apply_migration.py and migrate_to_supabase.py
# (Project Settings -> Database -> Connection string -> Session pooler)
DB_URL=postgresql://postgres.YOUR-PROJECT:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DB_PASSWORD=YOUR-DB-PASSWORD

# Supabase Management API token (Account -> Access Tokens).
# Needed only by deploy_supabase.py to push secrets and deploy Edge Functions.
SUPABASE_ACCESS_TOKEN=sbp_your-token

# ---------------------------------------------------------------------------
# Model provider: gemini (default) or cloudflare
#
#   gemini      Google AI Studio — 1,000 embeddings/day, multilingual
#   cloudflare  Workers AI — 10,000 neurons/day, English embeddings (768-dim)
#
# Both produce 768-dimensional vectors, so the pgvector schema is unchanged.
# Set the same value here and in the Edge Function secrets (deploy_supabase.py
# pushes it for you), otherwise corpus and queries land in different spaces.
# ---------------------------------------------------------------------------
LLM_PROVIDER=gemini

# Google AI Studio key (required when LLM_PROVIDER=gemini)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-2.5-flash

# Cloudflare Workers AI (required when LLM_PROVIDER=cloudflare)
# Account ID: Workers & Pages overview sidebar. Token: My Profile -> API Tokens
# -> Create Token -> "Workers AI" template.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CF_EMBED_MODEL=@cf/baai/bge-base-en-v1.5
CF_CHAT_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# Shared secret required by the ingest function for scripted uploads
INGEST_SECRET=generate-a-long-random-string

# Optional tuning
RATE_LIMIT_PER_MINUTE=30
EMBED_PAUSE=1.0

# Optional: Vercel deploy (scripts/deploy_vercel.sh)
VERCEL_TOKEN=
VERCEL_SITE_URL=https://your-app.vercel.app
