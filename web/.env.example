# ---------------------------------------------------------------------------
# Frontend env (Vercel project settings -> Environment Variables)
# ---------------------------------------------------------------------------

# Supabase project (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public site URL (used for auth redirects and metadata)
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Optional: fall back to the local FastAPI backend when Supabase is not set up.
# Leave empty in production (the Supabase Edge Function is the backend).
NEXT_PUBLIC_RAG_API_URL=
